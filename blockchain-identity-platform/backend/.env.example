# =============================================================
# DEVELOPMENT/TEST ONLY - NEVER USE THESE VALUES IN PRODUCTION
# =============================================================

# Hardhat node URL
BLOCKCHAIN_URL=http://127.0.0.1:8545

# Hardhat default account #0 private key (TEST ONLY - publicly known key)
# This key is used to sign transactions from the backend.
# NEVER expose, log, store in database, or return via API.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract addresses (update after running deploy script)
IDENTITY_CONTRACT_ADDRESS=
ASSET_CONTRACT_ADDRESS=

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
